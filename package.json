{
  "name": "@adminjs/adonis",
  "version": "2.0.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "author": {
    "name": "Rafał Dzięgielewski",
    "email": "rafal.dzieg@gmail.com"
  },
  "repository": "git@github.com:SoftwareBrothers/adminjs-adonis.git",
  "files": [
    "lib",
    "!lib/bin",
    "!lib/tests",
    "!lib/tests_helpers"
  ],
  "exports": {
    ".": {
      "import": "./lib/index.js",
      "types": "./lib/index.d.ts"
    },
    "./adminjs_provider": "./lib/providers/adminjs_provider.js"
  },
  "scripts": {
    "build": "npm run compile",
    "compile": "tsup-node && tsc --emitDeclarationOnly --declaration",
    "copy:templates": "copyfiles \"stubs/**/*.stub\" --up=\"1\" lib",
    "postcompile": "npm run copy:templates",
    "prepublishOnly": "npm run build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "release": "semantic-release"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.6.0",
    "@adonisjs/core": "^7.6.0",
    "@adonisjs/eslint-config": "^3.1.0",
    "@adonisjs/lucid": "^22.4.2",
    "@adonisjs/prettier-config": "^1.5.0",
    "@adonisjs/session": "^8.3.0",
    "@adonisjs/tsconfig": "^2.0.0",
    "@japa/assert": "^4.2.0",
    "@japa/plugin-adonisjs": "^5.2.0",
    "@japa/runner": "^5.4.0",
    "@semantic-release/git": "^10.0.1",
    "@types/luxon": "^3.4.2",
    "@types/node": "^24.0.0",
    "adminjs": "^7.8.17",
    "copyfiles": "^2.4.1",
    "eslint": "^10.14.0",
    "luxon": "^3.4.4",
    "pg": "^8.11.3",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "reflect-metadata": "^0.2.1",
    "semantic-release": "^21.0.1",
    "tsup": "^8.0.1",
    "typescript": "~5.9.3",
    "youch": "^4.1.1"
  },
  "dependencies": {
    "knex-schema-inspector": "^3.1.0"
  },
  "peerDependencies": {
    "@adonisjs/core": "^7.0.0",
    "@adonisjs/lucid": "^22.0.0",
    "@adonisjs/session": "^8.0.0",
    "reflect-metadata": "^0.2.1"
  },
  "peerDependenciesMeta": {
    "@adonisjs/lucid": {
      "optional": true
    }
  },
  "prettier": "@adonisjs/prettier-config",
  "tsup": {
    "entry": [
      "./index.ts",
      "./providers/adminjs_provider.ts",
      "./src/plugin/router.ts",
      "./src/types.ts",
      "./src/adapter/database.ts",
      "./src/adapter/lucid_resource.ts",
      "./src/adapter/property.ts",
      "./src/adapter/resource.ts",
      "./src/adapter/type_converter.ts"
    ],
    "outDir": "./lib",
    "clean": true,
    "format": "esm",
    "dts": false,
    "sourcemap": true,
    "target": "esnext"
  }
}
